.elan/
.venv/
.tools/
.lake/
.pytest_cache/
__pycache__/
*.pyc
*.olean
*.ilean
*.trace
.work/
dist/
build/
.env
# `just env-sync` writes .env.bak, and a real environment file must never be trackable under
# any name. The negation keeps the template itself, which is the one that is meant to be here.
.env.*
!.env.example
.venv-api/*
# Default ARTIFACT_ROOT for the submission API; artifact bytes are never committed.
.artifacts/
# Recreated at pinned revisions by scripts/pin_dependencies.sh.
vendor/

*.dump
# A database dump must never be trackable, whichever extension pg_dump was asked for. The
# negations keep the SQL that *is* source: the Flyway migrations, which are the schema's source of
# truth, and the operator scripts beside them. Without them a new migration is silently left out
# of `git add -A` and goes missing from a deploy — V001..V026 are tracked only because they
# predate this rule, and four scripts under scripts/ were swallowed by it.
*.sql
!deploy/migrate/sql/*.sql
!scripts/*.sql
deploy/axiom

.claude/*
AGENTS.md
CLAUDE.md

