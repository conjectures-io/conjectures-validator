# /etc/conjectures/competition-worker.env
#
# The gate host's configuration. Copy, fill in, and chmod 0600 -- it carries a database
# password. Everything the gate subprocess itself needs is here too, because the worker
# hands it an allowlist of exactly these names and nothing else.

APP_MODE=PROD

# REQUIRED in production. The competition database, not the proofs one: this host records
# verdicts and reads entitlements, and has no business reaching the proofs schema at all.
COMPETITION_DATABASE_URL=postgresql+psycopg://conjectures:CHANGE-ME@10.0.0.2:5432/conjectures_competition

# Which gates live on this host, and at which reviewed commit. See registry.json.
COMPETITION_REGISTRY_PATH=/etc/conjectures/competitions.json

# Restrict this host to the competitions whose toolchains it actually holds. Unset means
# every gate in the registry, which is right only when this host has them all.
COMPETITION_WORKER_COMPETITIONS=lz77

# REQUIRED to be bwrap in production: the gate compiles and runs miner-authored Rust, and
# 'off' exists for miners testing their own submissions locally.
VERIFY_SANDBOX=bwrap

# Where the gate's pinned toolchain lives. Passed through to the subprocess; nothing else
# from this file is.
ELAN_HOME=/srv/gates/.elan
CARGO_HOME=/srv/gates/.cargo
RUSTUP_HOME=/srv/gates/.rustup

# Optional. Defaults shown.
# COMPETITION_WORKER_ID=<hostname>:<pid>
# COMPETITION_STALE_CLAIM_SECONDS=7200
# COMPETITION_MAX_ATTEMPTS=3
# VERIFY_LEAN_TIMEOUT=900
# VERIFY_LEAN_MEMORY_MB=16384
# The held-out corpus. A validator scores against one the miners do not have.
# VERIFY_CORPUS=/srv/gates/corpus
