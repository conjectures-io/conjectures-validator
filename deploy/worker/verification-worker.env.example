# Install as /etc/conjectures/verification-worker.env, mode 0640, owned by
# root:conjectures-worker. Never commit the real password or deployment values.

APP_MODE=PROD
DATABASE_URL=postgresql+psycopg://conjectures:replace-me@127.0.0.1:5432/conjectures

# Production accepts only the out-of-process container runner.
VERIFICATION_RUNNER=container
VERIFIER_VERSION=validator-<release-git-commit>
VERIFIER_IMAGE=formal-conjectures-verifier:release

# Local image ID, not a tag and not a registry manifest digest. Obtain it only after pulling or
# building the reviewed image:
#   docker image inspect --format '{{.Id}}' formal-conjectures-verifier:release
VERIFIER_CONTAINER_DIGEST=sha256:<64-lowercase-hex-digits>
DOCKER_BINARY=/usr/bin/docker

# Root-owned, read-only release checkout of the separately audited task repository.
CONJECTURES_TASKS_ROOT=/opt/conjectures-tasks
TASK_ALLOWLIST_PATH=/opt/conjectures-tasks/allowlist.json
TASK_POOL_ROOT=/opt/conjectures-tasks/pool

# Human-readable label written into every lease. The worker appends a random per-process token so
# a restarted or duplicated service can never be mistaken for the previous lease holder.
VERIFICATION_WORKER_ID=<hostname>/production-worker-1
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_IDLE_SLEEP_SECONDS=5

# Outer container limits. The published tasks may run for an hour; do not lower these without
# reviewing the task deadlines and lease calculations together.
VERIFIER_MEMORY=72g
VERIFIER_CPUS=4
VERIFIER_PIDS_LIMIT=512
VERIFIER_CONTAINER_GRACE_SECONDS=300
VERIFICATION_LEASE_MARGIN_SECONDS=300

# Structured events to Axiom: severity, the area of the system, an event type. Optional — with no
# token the sink is a no-op and stderr logging is unchanged. See .env.example for the full set.
# AXIOM_TOKEN=
# AXIOM_DATASET=conjectures-validator
# AXIOM_ENVIRON=prod
