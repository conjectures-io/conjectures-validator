# /etc/conjectures/deploy-validator.env -- read by /usr/local/sbin/conjectures-deploy.
#
# Lives on the server, root-owned, mode 600. Nothing a workflow sends can change these values:
# GitHub chooses only the commit (and, if allowed below, the .env).

# The release checkout the deploy moves. A real directory, root-owned, clean, origin on GitHub.
CHECKOUT=/opt/conjectures-validator/current

# The only branch this server deploys from. A commit not on origin/$BRANCH is refused.
BRANCH=dev

# Compose services a deploy rebuilds and recreates. `db` is started if it is down but never
# recreated, and `migrate` always runs. Processes that sign or write to the chain (emissions,
# deposit watcher, registration watcher, weight setters) belong here only by an operator's
# decision.
#   dev server:  api
#   production:  api payout-notifier payout-watcher
DEPLOY_SERVICES="api"

# Further compose files this server's `conjectures-api` project was started with, after
# docker-compose.api.yml, separated by spaces: relative to CHECKOUT or absolute, plain paths only.
# Check what runs with `docker compose ls` (CONFIG FILES); a deploy that leaves one out recreates
# its services from a different configuration. Empty on the dev server.
#   e.g. "docker-compose.watcher.yml /opt/conjectures-validator/release-config/<release>/database-host.override.yml"
DEPLOY_COMPOSE_FILES=""

# 1 = a deploy may replace .env with the DOTENV secret of the GitHub environment (verb
# `deploy-env`). 0 = this server keeps its own .env and refuses one sent from GitHub.
ALLOW_ENV_FROM_GITHUB=1

# Where the API answers on this machine, and how long a deploy waits for /readyz.
HEALTH_URL=http://127.0.0.1:8000
HEALTH_TIMEOUT=180
API_CONTAINER=conjectures_api

# .env backups (one per change) and pre-migration database dumps (the last KEEP_BACKUPS kept).
BACKUP_DIR=/root/prod_backups/deploys
KEEP_BACKUPS=10
