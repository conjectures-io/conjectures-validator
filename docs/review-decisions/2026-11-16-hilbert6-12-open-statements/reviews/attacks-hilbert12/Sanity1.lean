import HilbertDrafts.Hilbert12Lambda

open HilbertDrafts.Hilbert12 HilbertDrafts.Hilbert12Lambda NumberField AlgebraicGeometry CategoryTheory
open scoped NumberField
open Opposite

namespace Review

variable {K : Type} [Field K]

/-- `scalar` is compatible with restriction. -/
theorem scalar_res (M : IntegralScheme K) {V W : M.X.Opens} (h : V ≤ W) (r : 𝓞 K) :
    (M.X.presheaf.map (homOfLE h).op).hom (M.scalar W r) = M.scalar V r := by
  simp only [IntegralScheme.scalar, RingHom.comp_apply]
  have := Scheme.Hom.appLE_map M.toBase (U := ⊤) (V := W) (V' := V) le_top (homOfLE h).op
  exact congrArg (fun g => g.hom ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 K))).inv.hom r)) this

/-- The basic open of a scalar is the preimage of the basic open of the base. -/
theorem mem_basicOpen_scalar_top (M : IntegralScheme K) (r : 𝓞 K) (x : M.X) :
    x ∈ M.X.basicOpen (M.scalar ⊤ r) ↔
      r ∉ (show PrimeSpectrum (𝓞 K) from M.toBase.base x).asIdeal := by
  have h1 : M.scalar ⊤ r =
      M.toBase.appTop ((Scheme.ΓSpecIso (CommRingCat.of (𝓞 K))).inv r) := by
    simp only [IntegralScheme.scalar, RingHom.comp_apply]
    change (M.toBase.appLE ⊤ (M.toBase ⁻¹ᵁ ⊤) le_rfl).hom _ = _
    rw [Scheme.Hom.appLE_eq_app]
    rfl
  rw [h1, ← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine]
  rfl

/-- `OverPrime p x` says exactly that `x` maps to the point `p` of the base. -/
theorem overPrime_iff [NumberField K] (M : IntegralScheme K) (p : Prime K) (x : M.X) :
    M.OverPrime p x ↔
      (show PrimeSpectrum (𝓞 K) from M.toBase.base x).asIdeal = p.asIdeal := by
  unfold IntegralScheme.OverPrime
  simp only [mem_basicOpen_scalar_top, not_not]
  constructor
  · intro h
    have hle : p.asIdeal ≤ (show PrimeSpectrum (𝓞 K) from M.toBase.base x).asIdeal := h
    have hmax : p.asIdeal.IsMaximal := p.isMaximal
    exact (hmax.eq_of_le
      (show PrimeSpectrum (𝓞 K) from M.toBase.base x).isPrime.ne_top hle).symm
  · intro h r hr
    rw [h]; exact hr

/-- At a point of the fibre the ideal generated by `p` is proper, so the
congruence clause of `IsFrobeniusLift` is not vacuous there. -/
theorem map_ne_top_of_overPrime (M : IntegralScheme K) (p : Prime K) (V : M.X.Opens)
    (x : M.X) (hx : x ∈ V) (hp : M.OverPrime p x) :
    Ideal.map (M.scalar V) p.asIdeal ≠ ⊤ := by
  intro htop
  let J : Ideal Γ(M.X, V) :=
    Ideal.comap (M.X.presheaf.germ V x hx).hom (IsLocalRing.maximalIdeal _)
  have hJ : Ideal.map (M.scalar V) p.asIdeal ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    have h1 : x ∉ M.X.basicOpen (M.scalar V r) := by
      rw [← scalar_res M (le_top : V ≤ ⊤) r, Scheme.basicOpen_res]
      exact fun h => hp r hr h.2
    rw [Scheme.mem_basicOpen _ _ _ hx] at h1
    exact h1
  have : (1 : Γ(M.X, V)) ∈ J := hJ (htop ▸ Submodule.mem_top)
  have h2 : (M.X.presheaf.germ V x hx).hom 1 ∈ IsLocalRing.maximalIdeal _ := this
  rw [map_one] at h2
  exact (IsLocalRing.maximalIdeal _).ne_top_iff_one.mp (IsLocalRing.maximalIdeal.isMaximal _).ne_top h2

/-- Away from the fibre the congruence clause is vacuous. -/
theorem map_eq_top_of_forall_not_overPrime (M : IntegralScheme K) (p : Prime K) (V : M.X.Opens)
    (hV : IsAffineOpen V) (h : ∀ x ∈ V, ¬ M.OverPrime p x) :
    Ideal.map (M.scalar V) p.asIdeal = ⊤ := by
  by_contra hne
  obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
  let y : Spec Γ(M.X, V) := (⟨m, hm.isPrime⟩ : PrimeSpectrum Γ(M.X, V))
  let x : M.X := hV.fromSpec.base y
  have hxV : x ∈ V := by
    have : x ∈ Set.range hV.fromSpec.base := ⟨y, rfl⟩
    rw [hV.range_fromSpec] at this
    exact this
  apply h x hxV
  intro r hr hmem
  have h1 : x ∈ M.X.basicOpen (M.scalar V r) := by
    rw [← scalar_res M (le_top : V ≤ ⊤) r, Scheme.basicOpen_res]
    exact ⟨hxV, hmem⟩
  have h2 : y ∈ hV.fromSpec ⁻¹ᵁ M.X.basicOpen (M.scalar V r) := h1
  rw [hV.fromSpec_preimage_basicOpen] at h2
  exact h2 (hle (Ideal.mem_map_of_mem _ hr))

/-- `value` evaluates a function at a point: on an affine scheme it is the ring map. -/
theorem value_affine (R L : CommRingCat.{0}) (φ : R ⟶ L) (r : R) :
    (Scheme.ΓSpecIso L).hom.hom
      (((Spec.map φ).appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso R).inv.hom r)) = φ.hom r := by
  have h := Scheme.ΓSpecIso_naturality φ
  have h2 : (Spec.map φ).appLE ⊤ ⊤ le_top = (Spec.map φ).appTop :=
    Scheme.Hom.appLE_eq_app (f := Spec.map φ) (U := ⊤)
  rw [h2]
  have h3 := congrArg (fun g => g.hom ((Scheme.ΓSpecIso R).inv.hom r)) h
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h3
  rw [h3]
  congr 1
  exact (Scheme.ΓSpecIso R).inv_hom_id_apply r

/-- The equivalence modulo a cycle is reflexive. -/
theorem equivalent_refl (f : HilbertDrafts.Hilbert12Lambda.Cycle K) (a : Ideal (𝓞 K)) :
    f.Equivalent a a := by
  refine ⟨1, fun σ _ => by simp, fun α => by simp, fun b' _ => ⟨0, f.finite.zero_mem, by simp⟩⟩

/-- A coarser cycle has a coarser equivalence, so periodic points only accumulate. -/
theorem equivalent_mono (f g : HilbertDrafts.Hilbert12Lambda.Cycle K)
    (hfin : g.finite ≤ f.finite) (hreal : ∀ σ ∈ f.real, σ ∈ g.real)
    (a b : Ideal (𝓞 K)) (h : g.Equivalent a b) : f.Equivalent a b := by
  obtain ⟨x, h1, h2, h3⟩ := h
  refine ⟨x, fun σ hσ => h1 σ (hreal σ hσ), h2, fun b' hb' => ?_⟩
  obtain ⟨c, hc, hc'⟩ := h3 b' hb'
  exact ⟨c, hfin hc, hc'⟩

end Review
