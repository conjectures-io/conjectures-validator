def HilbertDrafts.Hilbert6MeanField.VlasovPoissonMeanFieldLimit : Prop :=
∀ (f₀ : HilbertDrafts.Hilbert6.Phase → ℝ),
  HilbertDrafts.Hilbert6MeanField.SmoothDensity f₀ →
    (∃ f,
        HilbertDrafts.Hilbert6MeanField.IsVlasovPoissonSolution f ∧
          ∀ (z : HilbertDrafts.Hilbert6.Phase), f 0 z = f₀ z) ∧
      ∀ (f : ℝ → HilbertDrafts.Hilbert6.Phase → ℝ),
        HilbertDrafts.Hilbert6MeanField.IsVlasovPoissonSolution f →
          (∀ (z : HilbertDrafts.Hilbert6.Phase), f 0 z = f₀ z) →
            ∀ (t : ℝ),
              0 ≤ t →
                ∀ (φ : HilbertDrafts.Hilbert6.Phase → ℝ),
                  Continuous φ →
                    HasCompactSupport φ →
                      ∀ (δ : ℝ),
                        0 < δ →
                          Filter.Tendsto
                            (fun N =>
                              (HilbertDrafts.Hilbert6MeanField.productLaw N f₀)
                                (HilbertDrafts.Hilbert6MeanField.deviationSet N f t δ φ))
                            Filter.atTop (nhds 0)
def HilbertDrafts.Hilbert12Lambda.Hilbert12LambdaGeometric : Prop :=
∀ (K : Type) [inst : Field K] [inst_1 : NumberField K], HilbertDrafts.Hilbert12Lambda.LambdaGeometric K
def HilbertDrafts.Hilbert12Lambda.BorgerDeSmitQuestion4 : Prop :=
∃ K x,
  ∃ (x_1 : NumberField K),
    Module.finrank ℚ K ≠ 1 ∧
      ¬(Module.finrank ℚ K = 2 ∧ IsEmpty (K →+* ℝ)) ∧ HilbertDrafts.Hilbert12Lambda.LambdaGeometric K
