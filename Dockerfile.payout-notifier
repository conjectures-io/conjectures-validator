# Database-driven Discord payout-command notifier. It holds no wallet or signing key.

FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

# Reject the compromised eMudhra chains even when a base image or mirror has an old CA bundle.
# `upgrade` first: the base is pinned by digest, so the distribution's security fixes published
# since that digest was cut reach the image only here. The nightly image scan reads the result.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends ca-certificates \
    && sed -i -e 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt$|!&|' \
              -e 's|^mozilla/Comodo_AAA_Services_root.crt$|!&|' /etc/ca-certificates.conf \
    && /usr/sbin/update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-service.hashes ./
# Bootstrap pip against the patched system store; pip also bundles its own CA certificates.
# The interpreter's own copy of pip, ensurepip's bundled wheel, stays at whatever the Python
# release shipped and carries that version's advisories. Only `python -m venv` reads it, and
# nothing in this image makes a venv.
RUN PIP_CERT=/etc/ssl/certs/ca-certificates.crt python -m pip install --no-cache-dir --upgrade pip==26.2.2 \
    && rm -f /usr/local/lib/python3.12/ensurepip/_bundled/pip-*.whl

# `--require-hashes`: every file pip fetches has to match the sha256 recorded when the lock was
# generated (scripts/lock_dependencies.sh), so a substituted artifact fails the build.
RUN pip install --no-cache-dir --require-hashes --constraint requirements-service.hashes \
      SQLAlchemy greenlet 'psycopg[binary]' \
    && rm -f requirements-service.hashes

RUN useradd --create-home --shell /usr/sbin/nologin --uid 10104 notifier

USER notifier
WORKDIR /srv/app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONPATH=/srv/app

CMD ["python", "-m", "payout_notifier", "--log-level", "INFO"]
