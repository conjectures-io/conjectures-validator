# Copy to .env and adjust. Never commit the real .env.
#
#   cp .env.example .env
#   docker compose -f docker-compose.db.yml up -d

# --- Database credentials (used by the postgres image on first init) ----------
# These are read only when the data volume is empty. Changing them later does
# not change the role or database that already exists in the volume.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=conjectures
# Host port only; inside compose the database is always db:5432. Change this if
# another Postgres already holds 5432 on your machine.
POSTGRES_PORT=5432

# --- Read-only monitoring role created by deploy/db/00_init.sh ----------------
MONITOR_PASSWORD=change-me-monitor-password

# --- Connecting from the host (outside compose) -------------------------------
# Inside compose, services reach the database as `db`. Set this only to run
# scripts or tests from your machine against the container:
# DATABASE_URL=postgresql+psycopg://conjectures:change-me-strong-password@localhost:5432/conjectures

# --- Public read surface ------------------------------------------------------
# The catalog, results, and system endpoints are unauthenticated and read by a
# browser. Everything below has a working development default; the four marked
# REQUIRED IN PROD are refused at startup if left unset with APP_MODE=PROD.

# Exact browser origins allowed to read /v1, comma-separated. No wildcard and no
# pattern: scheme://host[:port], no trailing slash, https in production. Empty is
# valid and fail-closed — it means no browser may read the API.
# CORS_ALLOWED_ORIGINS=https://conjectures.io,https://www.conjectures.io

# REQUIRED IN PROD. Signs the opaque page cursors on the result feeds. Any value
# of 32+ characters; the published development constant is refused in production.
#   openssl rand -hex 32
# PUBLIC_CURSOR_SECRET=

# REQUIRED IN PROD. Salts the per-conjecture solver pseudonyms on
# /v1/catalog/conjectures/{slug}/activity. A hotkey is a 48-character address
# from a known alphabet, so an unsalted or publicly-salted digest is reversible
# by enumeration. Rotating this renames every pseudonym, which is intended.
#   openssl rand -hex 32
# PUBLIC_ACTIVITY_SALT=

# Per-client request ceiling on /v1. The limiter is in-process, so N replicas
# admit N times this rate: set the per-replica share, not the global one. Cannot
# be disabled in production.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_CLIENTS=50000

# How many rightmost X-Forwarded-For entries this deployment's own proxies added.
# 0 (the default) ignores the header entirely and uses the peer address, which is
# correct for a directly exposed process and is the only setting that cannot be
# spoofed. Set it to the real hop count behind a CDN or load balancer, or every
# visitor collapses onto one rate-limit budget.
# TRUSTED_PROXY_HOPS=0

# Cache-Control max-age on the public reads. 0 sends no-store.
# PUBLIC_CACHE_SECONDS=60

# Advertises an HTTP/3 authority for clients to retry over QUIC. Defaults to
# h3=":443"; ma=86400 in production and to nothing outside it. The ASGI app never
# sees the transport; this describes the deployment's edge, so change it if the
# edge does not terminate QUIC on 443.
# ALT_SVC=h3=":443"; ma=86400

# HSTS max-age, sent in production only. 0 disables the header.
# HSTS_MAX_AGE=31536000

# --- Operating switches -------------------------------------------------------
# Refuses POST /v1/submissions with 503 SUBMISSIONS_PAUSED and reports
# submissions_open: false on /v1/system/status. Set during the weekly pin
# rotation; the drain cannot complete while new work keeps arriving.
# SUBMISSIONS_PAUSED=false

# Operator message shown on /v1/system/status. Max 500 characters.
# STATUS_BANNER=

# The weekly drain-and-rotate window, reported on /v1/system/status so a solver
# can see when submissions are expected to close. Monday is 0, Sunday is 6.
# PIN_ROTATION_WEEKDAY=1
# PIN_ROTATION_START_UTC=02:00
# PIN_ROTATION_DURATION_MINUTES=240

# --- Accounts and sessions (Stage 2) ------------------------------------------
# The signed-in surface: /v1/auth, /v1/me, and the credit-funded submission path.
# See docs/ACCOUNT_API.md.

# REQUIRED IN PROD. Where the emailed sign-in link points. The WEBSITE's origin,
# not this API's: the link is clicked by a person in a browser and lands on a
# page, which then calls the API. Must be https in production.
# WEBSITE_BASE_URL=https://conjectures.io

# REQUIRED IN PROD (as `smtp`). `console` writes sign-in links — which are
# credentials — to the process log, so production refuses it. `smtp` fails closed
# until a transport is injected: it refuses to send rather than silently
# discarding mail, because the alternative is nobody being able to sign in and
# nothing in the logs saying why. See submission_api/mail.py.
# MAIL_SENDER=smtp

# Goes into every signed login message, binding the signature to this deployment
# so one produced for staging or a third-party instance is not valid here.
# LOGIN_DOMAIN=conjectures.io

# Session lifetime. Rolling: extended on use, so an active session does not
# expire under someone. The refresh interval is what keeps that from meaning a
# database write on every authenticated request.
# SESSION_DAYS=30
# SESSION_REFRESH_MINUTES=60

# Single-use credentials in transit, so both are short. Fifteen minutes is long
# enough to find the email and short enough that a link left in a browser history
# or a referrer header is already dead.
# EMAIL_LINK_MINUTES=15
# LOGIN_CHALLENGE_MINUTES=5

# Per-identity limits, on top of the per-IP limiter. Mailing a link is an action
# taken against someone else's mailbox, so what has to be bounded is requests per
# address rather than requests per requester — which the IP limiter cannot see.
# EMAIL_LINKS_PER_HOUR=5
# LOGIN_CHALLENGES_PER_HOUR=30

# How long a held credit stays held, and how long an account has to make a
# declared transfer. An intent holds a credit from the moment it opens, so this is
# also how long an abandoned attempt strands one.
# INTENT_MINUTES=30
# DEPOSIT_HOURS=24

# `credits[:bonus]`, comma-separated. A bonus is EXTRA CREDITS, never a discount:
# a package grants credits+bonus for credits x price. A bonus larger than its
# purchase is refused at startup as a likely typo.
# CREDIT_PACKAGES=1,10:1,50:8

# A pinned USD price for display, or nothing. Converting TAO to USD needs a live
# external rate this validator does not have, so the field is null unless set —
# and setting it requires the date, because a quoted price with no date cannot be
# judged for staleness.
# CREDIT_PRICE_USD=4.50
# CREDIT_PRICE_USD_ASOF=2026-08-01

# The terms served by GET /v1/catalog/submission-terms. The version in force when
# a submission was accepted is the version that governs it, so bump this when the
# document changes rather than editing in place silently.
# SUBMISSION_TERMS_PATH=./docs/SUBMISSION_TERMS.md
# SUBMISSION_TERMS_VERSION=v1
# SUBMISSION_TERMS_EFFECTIVE_FROM=2026-08-01

# --- Running the API with docker compose --------------------------------------
#   docker compose -f docker-compose.api.yml up -d --build
# brings up Postgres, applies migrations, then starts the API. The API port is
# bound to loopback only: TLS, HTTP/2 and HTTP/3 terminate at the edge.
# API_PORT=8000
# --- Verification worker (python -m verification_worker) ----------------------
# In PROD the worker refuses to start without these two: the in-process runner
# would compile a miner's proof inside the process holding the credentials
# above, and verifier_version is the record of what decided a submission.
# VERIFICATION_RUNNER=container
# VERIFIER_VERSION=v1
#
# The image is identified by digest at startup, read from the image itself
# unless pinned here. A tag is not an identity — :local points wherever the
# last build left it.
# VERIFIER_IMAGE=formal-conjectures-verifier:local
# VERIFIER_CONTAINER_DIGEST=sha256:<64-lowercase-hex-digits>
#
# Three claims of one submission is enough to establish that something is
# systematically wrong with it; a fourth costs another full task timeout and
# learns nothing. A submission at the cap waits for an operator.
# VERIFICATION_MAX_ATTEMPTS=3
# VERIFICATION_WORKER_ID=<hostname>/<pid>
