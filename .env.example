# Copy to .env and adjust. Never commit the real .env.
#
#   cp .env.example .env
#   docker compose -f docker-compose.db.yml up -d

# --- Database credentials (used by the postgres image on first init) ----------
# These are read only when the data volume is empty. Changing them later does
# not change the role or database that already exists in the volume.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=conjectures
# Host port only; inside compose the database is always db:5432. Change this if
# another Postgres already holds 5432 on your machine.
POSTGRES_PORT=5432

# --- Read-only monitoring role created by deploy/db/00_init.sh ----------------
MONITOR_PASSWORD=change-me-monitor-password

# Least-privilege service logins created only when the database volume is new.
API_DB_PASSWORD=change-me-api-password
VERIFIER_DB_PASSWORD=change-me-verifier-password
REVIEW_DB_PASSWORD=change-me-review-password
# Database-only credential for payout intent/confirmation; never a treasury signer secret.
REWARD_DB_PASSWORD=change-me-reward-password

# --- Connecting from the host (outside compose) -------------------------------
# Inside compose, services reach the database as `db`. Set this only to run
# scripts or tests from your machine against the container:
# DATABASE_URL=postgresql+psycopg://conjectures:change-me-strong-password@localhost:5432/conjectures

# --- Submission API ----------------------------------------------------------
APP_MODE=PROD
PAYMENT_RECIPIENT_SS58=replace-with-validator-payment-address
PAYMENT_AMOUNT_RAO=500000000
# Direct TAO reward quoted once when the paid submission is accepted.
BOUNTY_AMOUNT_RAO=1000000000
BOUNTY_POLICY_VERSION=flat-tao-v1
SUBTENSOR_NETWORK=finney
TASK_ALLOWLIST_PATH=task_pool/allowlist.json
TASK_POOL_ROOT=tasks/pool
SUBMISSION_AUTHENTICATOR=hotkey-signature
SUBMISSION_PAYMENT_VERIFIER=chain
SUBMISSION_DISPATCHER=queue
MANUAL_REWARD_REVIEW_ENABLED=true
REVIEW_POLICY_VERSION=v1
# Generate independently; production startup requires at least 32 characters.
REVIEW_API_TOKEN=replace-with-a-long-random-review-token
REVIEWER_IDENTITY=operator
