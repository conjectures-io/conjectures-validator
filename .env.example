# Copy to .env and adjust. Never commit the real .env.
#
#   cp .env.example .env
#   docker compose -f docker-compose.db.yml up -d

# --- Database credentials (used by the postgres image on first init) ----------
# These are read only when the data volume is empty. Changing them later does
# not change the role or database that already exists in the volume.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=conjectures
# Host port only; inside compose the database is always db:5432. Change this if
# another Postgres already holds 5432 on your machine.
POSTGRES_PORT=5432

# --- Read-only monitoring role created by deploy/db/00_init.sh ----------------
MONITOR_PASSWORD=change-me-monitor-password

# --- Connecting from the host (outside compose) -------------------------------
# Inside compose, services reach the database as `db`. Set this only to run
# scripts or tests from your machine against the container:
# DATABASE_URL=postgresql+psycopg://conjectures:change-me-strong-password@localhost:5432/conjectures

# --- Verification worker (python -m verification_worker) ----------------------
# In PROD the worker refuses to start without these two: the in-process runner
# would compile a miner's proof inside the process holding the credentials
# above, and verifier_version is the record of what decided a submission.
# VERIFICATION_RUNNER=container
# VERIFIER_VERSION=v1
#
# The image is identified by digest at startup, read from the image itself
# unless pinned here. A tag is not an identity — :local points wherever the
# last build left it.
# VERIFIER_IMAGE=formal-conjectures-verifier:local
# VERIFIER_CONTAINER_DIGEST=sha256:<64-lowercase-hex-digits>
#
# Three claims of one submission is enough to establish that something is
# systematically wrong with it; a fourth costs another full task timeout and
# learns nothing. A submission at the cap waits for an operator.
# VERIFICATION_MAX_ATTEMPTS=3
# VERIFICATION_WORKER_ID=<hostname>/<pid>
