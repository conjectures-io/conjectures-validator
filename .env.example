# Copy to .env and adjust. Never commit the real .env.
#
#   cp .env.example .env
#   docker compose -f docker-compose.db.yml up -d

# --- Database credentials (used by the postgres image on first init) ----------
# These are read only when the data volume is empty. Changing them later does
# not change the role or database that already exists in the volume.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=conjectures
# Host port only; inside compose the database is always db:5432. Change this if
# another Postgres already holds 5432 on your machine.
POSTGRES_PORT=5432

# --- Read-only monitoring role created by deploy/db/00_init.sh ----------------
MONITOR_PASSWORD=change-me-monitor-password

# --- Connecting from the host (outside compose) -------------------------------
# Inside compose, services reach the database as `db`. Set this only to run
# scripts or tests from your machine against the container:
# DATABASE_URL=postgresql+psycopg://conjectures:change-me-strong-password@localhost:5432/conjectures
